# Copy this file to ".env" and change the values. NEVER commit the real .env file.

# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-to-a-long-random-string

# PostgreSQL (main database). Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://brandguard:brandguard@localhost:5432/brandguard

ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_UPLOAD_MB=10
OCR_ENABLED=true
# Windows only, if Tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Optional AI layer (the rule engine works fully without it) ----
# LLM_PROVIDER=none  -> rule-based checks only (default)
# LLM_PROVIDER=openai_compatible -> any OpenAI-compatible chat API (OpenAI, Groq, a local Ollama server, ...)
LLM_PROVIDER=none
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
